using System;
using System.Collections.Generic;
using System.Text;

namespace Modul1_GudangOOP.Models;
public class Barang
{
// 1. Field (Atribut/Data)
public string KodeBarang;
public string NamaBarang;
public int JumlahStok;
public string Kategori;

// 2. Constructor Berparameter
public Barang(string kode, string nama, int stok, string kategori)
{
KodeBarang = kode;
NamaBarang = nama;
JumlahStok = stok;
Kategori = kategori;
}

// 3. Constructor Kosong (Overloading - Langkah 5)
public Barang()
{
KodeBarang = "UNKNOW";
NamaBarang = "Barang Baru";
JumlahStok = 0;
Kategori = "Umum";
}

// 4. Method Menampilkan Informasi
public void TampilkanInfo()
{
Console.WriteLine($"[{KodeBarang}] {NamaBarang} - Stok: {JumlahStok}, Kategori: {Kategori}");
}

// 5. Method Cek Status Stok (Langkah 4)
public string StatusStok()
{
return JumlahStok > 50 ? "Stok Aman" : "Perlu Reorder";
}
}
