@model List<Booking>
<h2 class="fw-bold mb-4">Booking Saya</h2>
@if(!Model.Any()){<div class="glass p-5 text-center text-secondary">Belum ada booking. <a asp-controller="Lapangan" asp-action="Index">Cari lapangan</a></div>}
<div class="row g-3">@foreach(var b in Model){ var c=b.Status=="Disetujui"?"success":(b.Status=="Dibatalkan"||b.Status=="Ditolak")?"danger":"warning";
<div class="col-md-6"><div class="glass p-3 d-flex justify-content-between align-items-center"><div>
<h5 class="mb-1">@b.Lapangan!.Nama</h5><div class="small text-secondary"><i class="bi bi-calendar3"></i> @b.Tanggal.ToString("dd MMM yyyy") &nbsp; <i class="bi bi-clock"></i> @b.JamMulai.ToString("00"):00 - @((b.JamMulai+b.Durasi).ToString("00")):00</div>
<strong class="brand">Rp @b.Total.ToString("N0")</strong></div>
<div class="text-end"><span class="badge text-bg-@c mb-2">@b.Status</span>
@if(b.Status=="Menunggu"){<form asp-action="Batal" asp-route-id="@b.Id" method="post"><button class="btn btn-sm btn-outline-danger d-block">Batalkan</button></form>}</div></div></div> }</div>
