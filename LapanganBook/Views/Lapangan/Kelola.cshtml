@model List<Lapangan>
<div class="d-flex justify-content-between mb-4">
    <h2 class="fw-bold">Kelola Lapangan</h2>
    <a class="btn btn-grad" asp-action="Form">
        <i class="bi bi-plus-lg"></i> Tambah
    </a>
</div>

<div class="glass p-3 table-responsive">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Nama</th>
                <th>Jenis</th>
                <th>Harga/jam</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lapangan in Model)
            {
                <tr>
                    <td>@lapangan.Nama</td>
                    <td>@lapangan.Jenis</td>
                    <td>Rp @lapangan.Harga.ToString("N0")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-info"
                            asp-action="Form"
                            asp-route-id="@lapangan.Id">Edit</a>
                        <form asp-action="Hapus"
                                asp-route-id="@lapangan.Id"
                                method="post"
                                class="d-inline"
                                onsubmit="return confirm('Hapus lapangan ini?')">
                            <button class="btn btn-sm btn-outline-danger">Hapus</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
