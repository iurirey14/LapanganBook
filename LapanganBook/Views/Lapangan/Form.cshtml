@model Lapangan
<div class="row justify-content-center"><div class="col-md-6"><div class="glass p-4"><h3 class="fw-bold mb-4">@(Model.Id==0?"Tambah":"Edit") Lapangan</h3>
<form method="post"><input type="hidden" name="Id" value="@Model.Id">
<label class="small text-secondary">Nama</label><input name="Nama" value="@Model.Nama" class="form-control mb-3" required>
<label class="small text-secondary">Jenis</label><select name="Jenis" class="form-select mb-3"><option selected="@(Model.Jenis=="Futsal")">Futsal</option><option selected="@(Model.Jenis=="Badminton")">Badminton</option></select>
<label class="small text-secondary">Harga per jam</label><input name="Harga" type="number" value="@((int)Model.Harga)" class="form-control mb-3" required>
<label class="small text-secondary">Deskripsi</label><textarea name="Deskripsi" rows="3" class="form-control mb-4">@Model.Deskripsi</textarea>
<button class="btn btn-grad">Simpan</button> <a class="btn btn-outline-light" asp-action="Kelola">Batal</a></form></div></div></div>
