@* ===== ORANG 4: Layout & tema ===== *@
<!DOCTYPE html><html lang="id" data-bs-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>LapanganBook</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--a1:#7c3aed;--a2:#06b6d4}
body{font-family:Poppins,sans-serif;background:#0b1020;background-image:radial-gradient(circle at 15% 0,#2a1b5e88,transparent 40%),radial-gradient(circle at 90% 20%,#06b6d433,transparent 35%);background-attachment:fixed;min-height:100vh}
.navbar{background:#0b1020cc;backdrop-filter:blur(12px);border-bottom:1px solid #ffffff14}
.brand{font-weight:800;background:linear-gradient(90deg,var(--a1),var(--a2));-webkit-background-clip:text;background-clip:text;color:transparent}
.btn-grad{background:linear-gradient(90deg,var(--a1),var(--a2));border:0;color:#fff;font-weight:600;border-radius:12px;padding:.5rem 1.2rem}
.btn-grad:hover{color:#fff;filter:brightness(1.12);transform:translateY(-1px)}
.glass{background:#ffffff0d;border:1px solid #ffffff1a;border-radius:20px;backdrop-filter:blur(10px)}
.card-l{transition:.25s}.card-l:hover{transform:translateY(-6px);border-color:var(--a2);box-shadow:0 12px 40px #06b6d422}
.thumb{height:150px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:3.5rem;color:#fff}
.Futsal{background:linear-gradient(135deg,#16a34a,#06b6d4)}.Badminton{background:linear-gradient(135deg,#7c3aed,#ec4899)}
.hero h1{font-weight:800;font-size:clamp(2.2rem,6vw,4rem)}
.stat{padding:1.3rem}.stat h3{font-weight:800}
.form-control,.form-select{background-color:#ffffff0d;border-color:#ffffff22;border-radius:12px}
</style></head><body>
<nav class="navbar navbar-expand-lg sticky-top"><div class="container">
<a class="navbar-brand brand fs-4" href="/"><i class="bi bi-trophy-fill"></i> LapanganBook</a>
<button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#n"><span class="navbar-toggler-icon"></span></button>
<div id="n" class="collapse navbar-collapse"><ul class="navbar-nav me-auto">
<li class="nav-item"><a class="nav-link" asp-controller="Lapangan" asp-action="Index">Lapangan</a></li>
@if(User.Identity!.IsAuthenticated){ <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Saya">Booking Saya</a></li> }
@if(User.IsInRole("Admin")){ <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Lapangan" asp-action="Kelola">Kelola Lapangan</a></li> }
</ul>
@if(User.Identity.IsAuthenticated){ <span class="me-3 small text-secondary"><i class="bi bi-person-circle"></i> @User.Identity.Name</span><a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Logout">Keluar</a> }
else { <a class="btn btn-sm btn-outline-light me-2" asp-controller="Account" asp-action="Login">Masuk</a><a class="btn btn-sm btn-grad" asp-controller="Account" asp-action="Register">Daftar</a> }
</div></div></nav>
<main class="container py-5">@RenderBody()</main>
<footer class="text-center text-secondary small pb-4">© 2026 LapanganBook</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", false)
</body></html>
