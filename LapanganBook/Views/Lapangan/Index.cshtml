@model List<Lapangan>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><h2 class="fw-bold">Pilih Lapangan</h2>
<div class="btn-group"><a class="btn btn-outline-light @(ViewBag.Jenis==null?"active":"")" href="?">Semua</a><a class="btn btn-outline-light @(ViewBag.Jenis=="Futsal"?"active":"")" href="?jenis=Futsal">Futsal</a><a class="btn btn-outline-light @(ViewBag.Jenis=="Badminton"?"active":"")" href="?jenis=Badminton">Badminton</a></div></div>
<div class="row g-4">@foreach(var l in Model){ <div class="col-md-6 col-lg-3"><div class="glass card-l p-3 h-100 d-flex flex-column">
<div class="thumb @l.Jenis"><i class="bi @(l.Jenis=="Futsal"?"bi-dribbble":"bi-trophy")"></i></div>
<h5 class="mt-3 mb-1">@l.Nama</h5><span class="badge text-bg-secondary align-self-start">@l.Jenis</span>
<p class="small text-secondary mt-2 flex-grow-1">@l.Deskripsi</p>
<div class="d-flex justify-content-between align-items-center"><strong class="brand">Rp @l.Harga.ToString("N0")<small>/jam</small></strong>
<a class="btn btn-grad btn-sm" asp-controller="Booking" asp-action="Create" asp-route-id="@l.Id">Booking</a></div></div></div> }</div>
